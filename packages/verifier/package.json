{
  "name": "@cubitrek/agent-passport-verifier",
  "version": "0.1.2",
  "description": "Reference verifier and issuer toolkit for the Agent Passport spec, v0.1. Validates schema, binds the Ed25519 signing key to the issuer's DNS zone, verifies the canonical-JSON signature, and checks expiry and revocation. Includes an agent-passport CLI for keygen, signing and verification.",
  "license": "MIT",
  "homepage": "https://github.com/Cubitrek/agent-passport#readme",
  "bugs": {
    "url": "https://github.com/Cubitrek/agent-passport/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cubitrek/agent-passport.git",
    "directory": "packages/verifier"
  },
  "author": "Cubitrek <hello@cubitrek.com> (https://cubitrek.com)",
  "keywords": [
    "agent-passport",
    "agent",
    "ai-agent",
    "a2a",
    "mcp",
    "trust",
    "ed25519",
    "well-known",
    "agentic"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-passport": "./bin/agent-passport.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./canonical": {
      "types": "./dist/canonical.d.ts",
      "import": "./dist/canonical.js"
    },
    "./package.json": "./package.json",
    "./node": {
      "types": "./dist/ledger-node.d.ts",
      "import": "./dist/ledger-node.js"
    }
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^20.16.0"
  }
}
